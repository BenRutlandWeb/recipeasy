---
import AppBarTitle from './AppBarTitle.astro';
import AppBarLink from './AppBarLink.astro';
import BaseIcon from './BaseIcon.vue';
import DarkModeToggle from './DarkModeToggle.vue';
interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<AppBarLink href={base} aria-label="Go back">
  <BaseIcon icon="arrow_back" />
</AppBarLink>
<AppBarTitle>{title}</AppBarTitle><DarkModeToggle client:idle />
