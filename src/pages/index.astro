---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppBar from '@/components/AppBar.astro';
import SmallRecipeCard from '@/components/SmallRecipeCard.vue';
import HomePersonalization from '@/components/islands/HomePersonalization.vue';
import { getAllKeywords, getAllRecipes, keywordToSlug } from '@/lib/recipes';
const recipes = getAllRecipes();
const keywords = getAllKeywords();
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Recipeasy">
  <AppBar title="Recipeasy" slot="header" />
  <HomePersonalization client:only="vue" recipes={recipes} />
  {
    keywords.length > 0 && (
      <section class="grid gap-3">
        <h2 class="text-xl font-semibold">Browse by tag</h2>
        <div class="flex flex-wrap gap-2">
          {keywords.map((keyword) => (
            <a
              href={`${base}browse/${keywordToSlug(keyword)}/`}
              class="chip rounded py-0.5 px-2 text-sm bg-gray-100 dark:bg-gray-800 capitalize"
            >
              {keyword}
            </a>
          ))}
        </div>
      </section>
    )
  }
  <h2 class="text-xl font-semibold">All recipes</h2>
  <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      recipes.map((recipe) => (
        <li>
          <SmallRecipeCard recipe={recipe} />
        </li>
      ))
    }
  </ul>
</BaseLayout>
