---
import RecipeLayout from '@/layouts/RecipeLayout.astro';
import RecipeAppBar from '@/components/RecipeAppBar.astro';
import RecipeImage from '@/components/RecipeImage.astro';
import RecipeChips from '@/components/RecipeChips.astro';
import SmallRecipeCard from '@/components/SmallRecipeCard.vue';
import RecipeActionButtons from '@/components/RecipeActionButtons.vue';
import RecipeInteractive from '@/components/islands/RecipeInteractive.vue';
import { getAllRecipes, getRecipe, getRelatedRecipes } from '@/lib/recipes';

export function getStaticPaths() {
  return getAllRecipes().map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const recipe = getRecipe(slug!);

if (!recipe) {
  return Astro.redirect(`${import.meta.env.BASE_URL}404`);
}

const related = getRelatedRecipes(slug!);
---

<RecipeLayout
  title={`${recipe.title} — Recipeasy`}
  description={recipe.description}
  recipe={recipe}
  slug={slug}
>
  <RecipeAppBar title={recipe.title} slot="header" />

  <div class="grid gap-6">
    <RecipeImage src={recipe.image} alt={recipe.title} />
    <RecipeActionButtons client:idle slug={slug} />
    <RecipeChips chips={recipe.keywords} />
  </div>

  <div class="grid gap-6 md:col-span-2">
    <h1 class="text-2xl font-semibold">{recipe.title}</h1>

    <p>{recipe.description}</p>

    <RecipeInteractive
      client:load
      slug={slug}
      serves={recipe.serves}
      prepTime={recipe.prepTime}
      cookTime={recipe.cookTime}
      ingredients={recipe.ingredients}
      methods={recipe.methods}
    />
  </div>

  {
    related.length > 0 && (
      <div class="grid gap-6 md:col-span-3">
        <h2 class="text-xl font-semibold mt-8">Related recipes</h2>
        <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {related.map((item) => (
            <li>
              <SmallRecipeCard recipe={item} />
            </li>
          ))}
        </ul>
      </div>
    )
  }
</RecipeLayout>
