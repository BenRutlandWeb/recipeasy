{
  "name": "recipeasy",
  "version": "0.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && npm run fallow && astro build",
    "fallow": "fallow dead-code --fail-on-issues --quiet",
    "serve": "astro preview",
    "preview": "astro preview",
    "validate": "node scripts/validate-recipes.mjs",
    "test": "vitest run",
    "lint": "eslint src scripts",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,vue,astro,json,css,md}": "prettier --write"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "fallow": "^3.20.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "postcss": "^8.5.23",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^10.4.1"
  },
  "dependencies": {
    "@astrojs/vue": "^7.0.3",
    "astro": "^7.3.3"
  }
}
