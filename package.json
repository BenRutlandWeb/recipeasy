    "*.{js,mjs,cjs,ts,tsx,vue,json,css,md}": "prettier --write"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "chokidar": "^4.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "postcss": "^8.5.23",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.0.0",
    "unplugin-vue-components": "^28.0.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  }
