{
  "name": "vite-recipes",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cd dist && cp index.html 404.html",
    "serve": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fallow": "fallow dead-code --fail-on-issues --quiet",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,vue,json,css,md}": "prettier --write"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "chokidar": "^6.0.0",
    "fallow": "^3.42.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  }
}
